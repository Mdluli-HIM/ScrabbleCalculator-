generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum TurnTilePremium {
  NONE
  DOUBLE_LETTER
  TRIPLE_LETTER
  DOUBLE_WORD
  TRIPLE_WORD
}

enum MatchStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DictionaryPolicy {
  LOCAL_WORD_LIST
  OXFORD_ONLY
  TOURNAMENT_LEXICON_ONLY
  BOTH_REQUIRED
  EITHER_ACCEPTED
}

enum MatchOwnerType {
  REGISTERED_USER
  GUEST_SESSION
}

enum MatchPlayerSource {
  REGISTERED_USER
  GUEST_PLAYER
  LOCAL
}

enum ExperiencePhase {
  OPENING
  ACTIVE
}

enum ExperienceCloseness {
  UNSET
  TIGHT
  COMPETITIVE
  OPEN
}

enum ExperienceRankMovement {
  NEW
  UP
  DOWN
  SAME
}

enum ExperienceMomentum {
  NEW
  SURGING
  BUILDING
  STEADY
  COOLING
}

enum ExperienceEventType {
  LEAD_CHANGE
  SHARED_LEAD
  RANK_RISE
  COMEBACK
  MOMENTUM_SHIFT
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique @db.VarChar(320)
  displayName  String     @db.VarChar(40)
  passwordHash String     @db.Text
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  refreshSessions      RefreshSession[]
  claimedGuestSessions GuestSession[]   @relation("ClaimedGuestSessions")
  ownedMatches         Match[]          @relation("UserOwnedMatches")
  matchPlayers         MatchPlayer[]    @relation("RegisteredMatchPlayers")

  @@index([status])
  @@map("users")
}

model RefreshSession {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique @db.Char(64)
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("refresh_sessions")
}

model GuestSession {
  id              String    @id @default(cuid())
  tokenHash       String    @unique @db.Char(64)
  expiresAt       DateTime
  claimedAt       DateTime?
  claimedByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  claimedBy    User?         @relation("ClaimedGuestSessions", fields: [claimedByUserId], references: [id], onDelete: SetNull)
  players      GuestPlayer[]
  ownedMatches Match[]       @relation("GuestOwnedMatches")

  @@index([expiresAt])
  @@index([claimedByUserId])
  @@map("guest_sessions")
}

model GuestPlayer {
  id             String   @id @default(cuid())
  guestSessionId String
  displayName    String   @db.VarChar(40)
  normalizedName String   @db.VarChar(40)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  guestSession GuestSession  @relation(fields: [guestSessionId], references: [id], onDelete: Cascade)
  matchPlayers MatchPlayer[] @relation("GuestMatchPlayers")

  @@unique([guestSessionId, normalizedName])
  @@index([guestSessionId])
  @@map("guest_players")
}

model Match {
  id                  String           @id @default(cuid())
  name                String?          @db.VarChar(80)
  status              MatchStatus      @default(DRAFT)
  dictionaryPolicy    DictionaryPolicy
  dictionaryLexiconId String?
  ownerType           MatchOwnerType
  ownerUserId         String?
  ownerGuestSessionId String?
  currentTurnOrder    Int?
  nextTurnNumber      Int              @default(1)
  startedAt           DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  ownerUser           User?                     @relation("UserOwnedMatches", fields: [ownerUserId], references: [id], onDelete: Restrict)
  ownerGuestSession   GuestSession?             @relation("GuestOwnedMatches", fields: [ownerGuestSessionId], references: [id], onDelete: Cascade)
  dictionaryLexicon   DictionaryLexicon?        @relation(fields: [dictionaryLexiconId], references: [id], onDelete: Restrict)
  players             MatchPlayer[]
  turns               Turn[]
  experienceSnapshots MatchExperienceSnapshot[]

  @@index([ownerUserId])
  @@index([ownerGuestSessionId])
  @@index([dictionaryLexiconId])
  @@index([status])
  @@index([createdAt])
  @@map("matches")
}

model MatchPlayer {
  id               String            @id @default(cuid())
  matchId          String
  source           MatchPlayerSource
  registeredUserId String?
  guestPlayerId    String?
  displayName      String            @db.VarChar(40)
  normalizedName   String            @db.VarChar(40)
  seatNumber       Int
  turnOrder        Int
  totalPoints      Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  match                   Match                     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  registeredUser          User?                     @relation("RegisteredMatchPlayers", fields: [registeredUserId], references: [id], onDelete: Restrict)
  guestPlayer             GuestPlayer?              @relation("GuestMatchPlayers", fields: [guestPlayerId], references: [id], onDelete: Restrict)
  turns                   Turn[]
  experienceStandings     MatchExperienceStanding[]
  experienceEvents        MatchExperienceEvent[]    @relation("ExperienceEventPlayer")
  relatedExperienceEvents MatchExperienceEvent[]    @relation("ExperienceEventRelatedPlayer")

  @@unique([matchId, normalizedName])
  @@unique([matchId, seatNumber])
  @@unique([matchId, turnOrder])
  @@index([matchId])
  @@index([registeredUserId])
  @@index([guestPlayerId])
  @@map("match_players")
}

model DictionaryLexicon {
  id          String   @id @default(cuid())
  code        String   @db.VarChar(40)
  version     String   @db.VarChar(40)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  isCurrent   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  words   DictionaryWord[]
  matches Match[]

  @@unique([code, version])
  @@index([code, isCurrent])
  @@map("dictionary_lexicons")
}

model DictionaryWord {
  id        String   @id @default(cuid())
  lexiconId String
  word      String   @db.VarChar(40)
  createdAt DateTime @default(now())

  lexicon DictionaryLexicon @relation(fields: [lexiconId], references: [id], onDelete: Cascade)

  @@unique([lexiconId, word])
  @@index([word])
  @@map("dictionary_words")
}

model SystemMetadata {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_metadata")
}

model Turn {
  id                   String   @id @default(cuid())
  matchId              String
  matchPlayerId        String
  turnNumber           Int
  idempotencyKey       String   @db.VarChar(120)
  wordPoints           Int
  bingoBonus           Int      @default(0)
  points               Int
  placedTileCount      Int
  replacementTileCount Int
  createdAt            DateTime @default(now())

  match              Match                    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchPlayer        MatchPlayer              @relation(fields: [matchPlayerId], references: [id], onDelete: Cascade)
  words              TurnWord[]
  placedTiles        TurnPlacedTile[]
  experienceSnapshot MatchExperienceSnapshot?

  @@unique([matchId, turnNumber])
  @@unique([matchId, idempotencyKey])
  @@index([matchPlayerId])
  @@index([createdAt])
  @@map("turns")
}

model TurnWord {
  id             String   @id @default(cuid())
  turnId         String
  wordOrder      Int
  word           String   @db.VarChar(40)
  letterPoints   Int
  wordMultiplier Int
  points         Int
  createdAt      DateTime @default(now())

  turn Turn @relation(fields: [turnId], references: [id], onDelete: Cascade)

  @@unique([turnId, wordOrder])
  @@index([turnId])
  @@map("turn_words")
}

model TurnPlacedTile {
  id           String          @id @default(cuid())
  turnId       String
  tileOrder    Int
  clientTileId String          @db.VarChar(60)
  letter       String          @db.VarChar(1)
  isBlank      Boolean
  premium      TurnTilePremium
  createdAt    DateTime        @default(now())

  turn Turn @relation(fields: [turnId], references: [id], onDelete: Cascade)

  @@unique([turnId, tileOrder])
  @@unique([turnId, clientTileId])
  @@index([turnId])
  @@map("turn_placed_tiles")
}

model MatchExperienceSnapshot {
  id            String              @id @default(cuid())
  matchId       String
  turnId        String?             @unique
  turnNumber    Int
  phase         ExperiencePhase
  closeness     ExperienceCloseness
  hasSharedLead Boolean
  createdAt     DateTime            @default(now())

  match     Match                     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  turn      Turn?                     @relation(fields: [turnId], references: [id], onDelete: Cascade)
  standings MatchExperienceStanding[]
  events    MatchExperienceEvent[]

  @@unique([matchId, turnNumber])
  @@index([matchId, createdAt])
  @@map("match_experience_snapshots")
}

model MatchExperienceStanding {
  id            String                 @id @default(cuid())
  snapshotId    String
  matchPlayerId String
  rank          Int
  movement      ExperienceRankMovement
  momentum      ExperienceMomentum
  isLeader      Boolean
  createdAt     DateTime               @default(now())

  snapshot    MatchExperienceSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  matchPlayer MatchPlayer             @relation(fields: [matchPlayerId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, matchPlayerId])
  @@index([matchPlayerId])
  @@index([snapshotId, rank])
  @@map("match_experience_standings")
}

model MatchExperienceEvent {
  id                   String              @id @default(cuid())
  snapshotId           String
  type                 ExperienceEventType
  matchPlayerId        String
  relatedMatchPlayerId String?
  createdAt            DateTime            @default(now())

  snapshot      MatchExperienceSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  matchPlayer   MatchPlayer             @relation("ExperienceEventPlayer", fields: [matchPlayerId], references: [id], onDelete: Cascade)
  relatedPlayer MatchPlayer?            @relation("ExperienceEventRelatedPlayer", fields: [relatedMatchPlayerId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@index([matchPlayerId])
  @@index([relatedMatchPlayerId])
  @@index([type])
  @@map("match_experience_events")
}
