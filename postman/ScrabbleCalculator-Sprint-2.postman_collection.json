{
  "info": {
    "_postman_id": "f923dce6-0ef7-4d57-8204-4e4d844a76b1",
    "name": "ScrabbleCalculator API - Sprint 2",
    "description": "Complete Sprint 2 workflow for registered and guest match setup, player management, ordering, starting, cancelling and ownership transfer.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Foundation",
      "item": [
        {
          "name": "API Health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/{{apiVersion}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('API version is 0.3.0', function () {",
                  "  pm.expect(body.data.status).to.eql('healthy');",
                  "  pm.expect(body.data.version).to.eql('0.3.0');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Database Health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/{{apiVersion}}/health/database"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Database is connected', function () {",
                  "  pm.expect(body.data.status).to.eql('connected');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Registered Identity",
      "item": [
        {
          "name": "Register Sprint 2 User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/{{apiVersion}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"displayName\": \"{{displayName}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(",
                  "  'email',",
                  "  'sprint2.' + Date.now() + '@example.com'",
                  ");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.environment.set('registeredUserId', body.data.user.id);",
                  "pm.environment.set('accessToken', body.data.tokens.accessToken);",
                  "pm.environment.set('refreshToken', body.data.tokens.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/{{apiVersion}}/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('User ID matches', function () {",
                  "  pm.expect(body.data.user.id)",
                  "    .to.eql(pm.environment.get('registeredUserId'));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 - Registered Match Setup",
      "item": [
        {
          "name": "Reject Unauthenticated Match Creation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/{{apiVersion}}/matches",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dictionaryPolicy\": \"OXFORD_ONLY\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', function () {",
                  "  pm.response.to.have.status(401);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Actor is required', function () {",
                  "  pm.expect(body.error.code).to.eql('MATCH_ACTOR_REQUIRED');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Registered Match",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/{{apiVersion}}/matches",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sprint 2 Registered Match\",\n  \"dictionaryPolicy\": \"EITHER_ACCEPTED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.environment.set('registeredMatchId', body.data.match.id);",
                  "pm.test('Draft is created', function () {",
                  "  pm.expect(body.data.match.status).to.eql('DRAFT');",
                  "  pm.expect(body.data.match.ownerType)",
                  "    .to.eql('REGISTERED_USER');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject Starting Without Players",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/{{apiVersion}}/matches/{{registeredMatchId}}/start",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 409', function () {",
                  "  pm.response.to.have.status(409);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Minimum players are required', function () {",
                  "  pm.expect(body.error.code)",
                  "    .to.eql('MATCH_REQUIRES_MORE_PLAYERS');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Add Registered Player",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/{{apiVersion}}/matches/{{registeredMatchId}}/players",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source\": \"REGISTERED_USER\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "const player = body.data.match.players.find(function (item) {",
                  "  return item.source === 'REGISTERED_USER';",
                  "});",
                  "pm.environment.set('registeredPlayerId', player.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Add Local Player",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/{{apiVersion}}/matches/{{registeredMatchId}}/players",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source\": \"LOCAL\",\n  \"displayName\": \"Lerato\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "const player = body.data.match.players.find(function (item) {",
                  "  return item.displayName === 'Lerato';",
                  "});",
                  "pm.environment.set('localPlayerId', player.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject Duplicate Local Name",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/{{apiVersion}}/matches/{{registeredMatchId}}/players",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source\": \"LOCAL\",\n  \"displayName\": \"  LERATO  \"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 409', function () {",
                  "  pm.response.to.have.status(409);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Normalized duplicate is rejected', function () {",
                  "  pm.expect(body.error.code)",
                  "    .to.eql('MATCH_PLAYER_NAME_ALREADY_EXISTS');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Set Seat and Turn Order",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/{{apiVersion}}/matches/{{registeredMatchId}}/players/order",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"seatOrder\": [\n    \"{{localPlayerId}}\",\n    \"{{registeredPlayerId}}\"\n  ],\n  \"turnOrder\": [\n    \"{{registeredPlayerId}}\",\n    \"{{localPlayerId}}\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Ordering is saved', function () {",
                  "  pm.expect(body.data.match.players[0].seatNumber).to.eql(1);",
                  "  pm.expect(body.data.match.players[1].seatNumber).to.eql(2);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Start Registered Match",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/{{apiVersion}}/matches/{{registeredMatchId}}/start",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Match is active', function () {",
                  "  pm.expect(body.data.match.status).to.eql('IN_PROGRESS');",
                  "  pm.expect(body.data.match.currentTurnOrder).to.eql(1);",
                  "  pm.expect(body.data.match.currentPlayer.id)",
                  "    .to.eql(pm.environment.get('registeredPlayerId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject Editing Active Match",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/{{apiVersion}}/matches/{{registeredMatchId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"This Must Not Be Saved\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 409', function () {",
                  "  pm.response.to.have.status(409);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Active match cannot be edited', function () {",
                  "  pm.expect(body.error.code).to.eql('MATCH_NOT_EDITABLE');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Registered Match",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/{{apiVersion}}/matches/{{registeredMatchId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Scores remain hidden', function () {",
                  "  pm.expect(JSON.stringify(body.data.match).toLowerCase())",
                  "    .not.to.include('score');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List Registered Matches",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/{{apiVersion}}/matches"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('One registered match exists', function () {",
                  "  pm.expect(body.data.total).to.eql(1);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancel Registered Match",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/{{apiVersion}}/matches/{{registeredMatchId}}/cancel",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Match is cancelled', function () {",
                  "  pm.expect(body.data.match.status).to.eql('CANCELLED');",
                  "  pm.expect(body.data.match.currentTurnOrder).to.eql(null);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject Repeated Cancellation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/{{apiVersion}}/matches/{{registeredMatchId}}/cancel",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 409', function () {",
                  "  pm.response.to.have.status(409);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Repeated cancellation is rejected', function () {",
                  "  pm.expect(body.error.code)",
                  "    .to.eql('MATCH_NOT_CANCELLABLE');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 - Guest Match and Ownership Transfer",
      "item": [
        {
          "name": "Create Guest Session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/{{apiVersion}}/guest/sessions",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.environment.set(",
                  "  'guestSessionToken',",
                  "  body.data.guestSessionToken",
                  ");",
                  "pm.environment.set(",
                  "  'guestSessionId',",
                  "  body.data.guestSession.id",
                  ");"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Guest Player One",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-guest-session-token",
                "value": "{{guestSessionToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/{{apiVersion}}/guest/players",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"Guest Marcus\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.environment.set('guestPlayerOneId', body.data.player.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Guest Player Two",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-guest-session-token",
                "value": "{{guestSessionToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/{{apiVersion}}/guest/players",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"Guest Lerato\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.environment.set('guestPlayerTwoId', body.data.player.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Guest Match",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
